'label_guardianaddress'><span id='label_guardianaddress'>Address:</span></td><td class='text data' colspan='1' id='text_guardianaddress'  data-value=''></td></tr>\n<tr><td class='label_custom' colspan='1' id='label_guardiancity'><span id='label_guardiancity'>City:</span></td><td class='text data' colspan='1' id='text_guardiancity'  data-value=''></td><td class='label_custom' colspan='1' id='label_guardianstate'><span id='label_guardianstate'>State:</span></td><td class='text data' colspan='1' id='text_guardianstate'  data-value=''><span> <i class=\"fa fas fa-exclamation-circle ml-1\"></i></span></td></tr>\n<tr><td class='label_custom' colspan='1' id='label_guardianpostalcode'><span id='label_guardianpostalcode'>Postal Code:</span></td><td class='text data' colspan='1' id='text_guardianpostalcode'  data-value=''></td><td class='label_custom' colspan='1' id='label_guardiancountry'><span id='label_guardiancountry'>Country:</span></td><td class='text data' colspan='1' id='text_guardiancountry'  data-value=''><span> <i class=\"fa fas fa-exclamation-circle ml-1\"></i></span></td></tr>\n<tr><td class='label_custom' colspan='1' id='label_guardianphone'><span id='label_guardianphone'>Phone:</span></td><td class='text data' colspan='1' id='text_guardianphone'  data-value=''></td><td class='label_custom' colspan='1' id='label_guardianworkphone'><span id='label_guardianworkphone'>Work Phone:</span></td><td class='text data' colspan='1' id='text_guardianworkphone'  data-value=''></td></tr>\n<tr><td class='label_custom' colspan='1' id='label_guardianemail'><span id='label_guardianemail'>Email:</span></td><td class='text data' colspan='1' id='text_guardianemail'  data-value=''></td><td></td><td></td></tr>\n<tr></td><td class='text data' colspan='4' id='text_related_persons'  data-value=''>\n<style>\n    .relation-inactive-display {\n        opacity: 0.6;\n        background-color: var(--light);\n        font-style: italic;\n    }\n    .relation-card {\n        border: 1px solid #dee2e6;\n        border-radius: 0.25rem;\n        margin-bottom: 1rem;\n        background-color: var(--white);\n    }\n    .relation-card-header {\n        background-color: var(--light);\n        padding: 0.75rem 1rem;\n        border-bottom: 1px solid #dee2e6;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n    .relation-card-body {\n        padding: 1rem;\n    }\n    .relation-section {\n        margin-top: 1rem;\n        padding-top: 1rem;\n        border-top: 1px solid #e9ecef;\n    }\n</style>\n\n<div id=\"table_display_relations_6a92fd37580f4\" class=\"form-row mt-3\">\n    <div class=\"table_text_relations col-12\">\n        <div class=\"text_relations_header label_custom pl-1\" style=\"display: flex; justify-content: space-between; align-items: center; padding-top: 0.2rem; padding-bottom: 0.2rem; background-color: var(--gray300)\">\n            <div>Related Persons</div>\n                    </div>\n\n                \n                <div class=\"no_relations\">\n            <span class=\"text data pl-1\">NO RELATED PERSONS</span>\n            <hr class=\"m-0 p-0\" style=\"border-top-width: 2px; border-color: var(--gray300)\" />\n        </div>\n        \n            </div>\n</div>\n\n<script type=\"text/javascript\">\n    function toggleInactiveRelationsDisplay(tableId) {\n        const checkbox = document.getElementById('show_inactive_relations_display_' + tableId);\n        const table = document.getElementById(tableId);\n\n        if (!table) {\n            console.error('Table not found:', tableId);\n            return;\n        }\n\n        const inactiveRelations = table.querySelectorAll('.relation-inactive-display');\n\n        console.log('Toggle inactive relations:', {\n            tableId: tableId,\n            checked: checkbox.checked,\n            foundRelations: inactiveRelations.length\n        });\n\n        inactiveRelations.forEach(function(relation) {\n            if (checkbox.checked) {\n                relation.classList.remove('d-none');\n            } else {\n                relation.classList.add('d-none');\n            }\n        });\n    }\n</script>\n</td></tr>\n</table>\n</div>\n\n</div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"card \">\n    <div class=\"card-body p-1\">\n        <h6 class=\"card-title mb-0 d-flex p-1 justify-content-between\">\n            <a class=\"text-left font-weight-bolder\" href=\"#\"  data-toggle=\"collapse\" data-target=\"#billing_ps_expand\"  aria-expanded=\"true\" aria-controls=\"billing_ps_expand\">Billing<i class=\"ml-1 fa fa-fw  fa-compress \" data-target=\"#billing_ps_expand\"></i></a>\n                    </h6>\n        <div id=\"billing_ps_expand\" class=\"card-text collapse show\">\n            <div class=\"clearfix pt-2\">\n                <div class=\"container\">\n    <div class=\"row\">\n        <div class=\"col-4\">Patient Balance Due</div>\n        <div class=\"col\">-25.00</div>\n    </div>\n    <div class=\"row\">\n        <div class=\"col-4\">Insurance Balance Due</div>\n        <div class=\"col\">175.00</div>\n    </div>\n    <div class=\"row\">\n        <div class=\"col-4\">Total Balance Due</div>\n        <div class=\"col\">150.00</div>\n    </div>\n\n    \n    \n            <div class=\"row\">\n        <div class=\"col-4\">Primary Insurance</div>\n        <div class=\"col\">Aekna</div>\n    </div>\n            <div class=\"row\">\n        <div class=\"col-4\">Effective Date</div>\n        <div class=\"col\">2012-02-08</div>\n    </div>\n    <div class=\"row\">\n        <div class=\"col-4\">Effective Date End</div>\n        <div class=\"col\"></div>\n    </div>\n    \n</div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"card \">\n    <div class=\"card-body p-1\">\n        <h6 class=\"card-title mb-0 d-flex p-1 justify-content-between\">\n            <a class=\"text-left font-weight-bolder\" href=\"#\"  data-toggle=\"collapse\" data-target=\"#insurance_ps_expand\"  aria-expanded=\"true\" aria-controls=\"insurance_ps_expand\">Insurance<i class=\"ml-1 fa fa-fw  fa-compress \" data-target=\"#insurance_ps_expand\"></i></a>\n                            <span>\n                                                    <a class=\"\" href=\"insurance_edit.php\"  ><i class=\"fa fa-pencil-alt\">&nbsp;</i></a>\n                                </span>\n                    </h6>\n        <div id=\"insurance_ps_expand\" class=\"card-text collapse show\">\n            <div class=\"clearfix pt-2\">\n                <ul class=\"nav nav-tabs mb-2 insurance-nav-tabs\">\n            <li class=\"nav-item\" role=\"presentation\">\n        <a data-type=\"primary\" href=\"#primary\" id=\"primary-tab\" data-toggle=\"tab\" role=\"tab\" aria-controls=\"primary\" aria-selected=\"true\" class=\"nav-link active\">\n            Primary\n        </a>\n                            <li class=\"nav-item\" role=\"presentation\">\n        <a id='eligibility-tab' class=\"nav-link\" href='#eligibility' data-toggle=\"tab\" aria-controls=\"eligibility\" role=\"tab\" aria-selected=\"false\">Eligibility</a>\n    </li>\n</ul>\n<div class=\"tab-content px-1\">\n<div class=\"tab-pane active\" id=\"primary\" role=\"tabpanel\" aria-labelledby=\"primary-tab\">\n            <div class=\"tab-pagination-pane \" id=\"primary-1\">\n            <div class=\"text-primary pb-2 pt-1\">\n                Primary Insurance\n                from 2012-02-08                 until Present\n            </div>\n            <div class=\"d-flex justify-content-between\">\n                <div class=\"insurer\">\n                                            <em>Insurer</em>\n                        <address>\n                            <strong>Aekna</strong><br>\n                            4345 Donkey Road<br>\n                            \n                            Longview FL, 44433\n                        </address>\n                                    </div>\n                <div class=\"subscriber\">\n                                                                                <em>Subscriber</em>\n                    <address class=\"mb-1\">\n                        <strong>Phil  Belford (Self)</strong><br>\n                        6666 String Street<br>\n                        Longview FL, 44433\n                         USA\n                    </address>\n                                        <strong>S.S.</strong>\n                    <span class=\"\">333222333</span><br>\n                                                            <strong>D.O.B.</strong>\n                    <span class=\"\">1972-02-09</span><br>\n                                                            <strong>Phone</strong>\n                    <span class=\"\">333-444-2222</span><br>\n                                    </div>\n                <div class=\"subscriber-employer\">\n                                                                                <em>Subscriber Employer</em>\n                    <address class=\"mb-1\">\n                        <strong>Using Pens Inc.</strong><br>\n                        23344 Watchahee Road<br>\n                        Longview FL, 444333\n                         USA\n                    </address>\n                </div>\n            </div>\n            <div class=\"d-flex justify-content-between policy-details pt-2\">\n                <div class=\"list-group list-group-flush flex-fill mr-4\">\n                    <div class=\"list-group-item d-flex justify-content-between p-1\"><strong>Plan Name:</strong> <span class=\"text-right\">Bad Plan</span></div>\n                    <div class=\"list-group-item d-flex justify-content-between p-1\"><strong>Policy Number:</strong> <span class=\"text-right text-monospace\">555</span></div>\n                    <div class=\"list-group-item d-flex justify-content-between p-1\"><strong>Group Number:</strong> <span class=\"text-right text-monospace\">444</span></div>\n                </div>\n                <div class=\"list-group list-group-flush flex-fill\">\n                    <div class=\"list-group-item d-flex justify-content-between p-1\"><strong>Copay:</strong> <span class=\"text-right\"></span></div>\n                    <div class=\"list-group-item d-flex justify-content-between p-1\"><strong>Accepts Assignment:</strong> <span class=\"text-right\">Yes</span></div>\n                                    </div>\n            </div>\n        </div>\n                <nav aria-label=\"Insurance List Navigation\">\n            <ul class=\"pagination justify-content-left mt-3\">\n                <li class=\"page-item disabled\">\n                    <a class=\"page-link insurance-pagination-link insurance-pagination-prev\"\n                       data-type=\"primary\" href=\"#primary\">Previous</a>\n                </li>\n                                <li class=\"page-item insurance-pagination-item active\">\n                    <a class=\"page-link\" data-policy-id=\"1\" data-type=\"primary\" href=\"#primary\" >\n                        1\n                </a></li>\n                                            </ul>\n        </nav>\n    </div>\n    <div class=\"tab-pane\" id=\"eligibility\" role=\"tabpanel\" aria-labelledby=\"eligibility-tab\">\n                    <div class='row'><br /><span><b>Nothing To Report</b></span><br /></div>\n\n            </div>\n    <script>\n        function updatePageNavigationButtonsForTarget(type, target) {\n            // update previous and next links\n            let prevLink = document.querySelector('#' + type + ' .pagination .insurance-pagination-prev');\n            let targetPolicyParentNode = target.closest('.page-item');\n            let previousElementSibling = targetPolicyParentNode.previousElementSibling;\n            if (previousElementSibling && previousElementSibling.classList.contains('insurance-pagination-item')) {\n                prevLink.closest('.page-item').classList.remove('disabled');\n                prevLink.dataset['policyId'] = previousElementSibling.querySelector('a').dataset['policyId'];\n            } else {\n                prevLink.closest('.page-item').classList.add('disabled');\n                prevLink.dataset['policyId'] = null;\n            }\n            let nextLink = document.querySelector('#' + type + ' .pagination .insurance-pagination-next');\n            if (nextLink) {\n                let nextElementSibling = targetPolicyParentNode.nextElementSibling;\n                if (nextElementSibling && nextElementSibling.classList.contains('insurance-pagination-item')) {\n                    nextLink.closest('.page-item').classList.remove('disabled');\n                    nextLink.dataset['policyId'] = nextElementSibling.querySelector('a').dataset['policyId'];\n                } else {\n                    nextLink.closest('.page-item').classList.add('disabled');\n                    nextLink.dataset['policyId'] = null;\n                }\n            }\n        }\n        function updateInsurancePaginationPane(e) {\n            e.preventDefault();\n            let policyId = e.target.dataset['policyId'];\n            let type = e.target.dataset['type'];\n            document.querySelectorAll('#' + type + ' .tab-pagination-pane').forEach(pane => {\n                pane.classList.add('d-none');\n            });\n            document.querySelector('#' + type + ' #' + type + '-' + policyId).classList.remove('d-none');\n            document.querySelectorAll('#' + type + ' .pagination .page-item').forEach(item => {\n                item.classList.remove('active');\n            });\n            e.target.parentNode.classList.add('active');\n            updatePageNavigationButtonsForTarget(type, e.target);\n        }\n\n        function triggerInsuranceNavigationAction(e) {\n            e.preventDefault();\n            let policyId = e.target.dataset['policyId'];\n            let type = e.target.dataset['type'];\n            let target = document.querySelector('#' + type + ' .pagination .insurance-pagination-item .page-link[data-policy-id=\"' + policyId + '\"]');\n            if (target) {\n                target.click();\n            }\n        }\n        document.querySelectorAll('.pagination .insurance-pagination-item').forEach(link => {\n            link.addEventListener('click', updateInsurancePaginationPane);\n        });\n        document.querySelectorAll('.pagination .insurance-pagination-link').forEach(link => {\n            link.addEventListener('click', triggerInsuranceNavigationAction);\n        });\n    </script>\n</div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"card \">\n    <div class=\"card-body p-1\">\n        <h6 class=\"card-title mb-0 d-flex p-1 justify-content-between\">\n            <a class=\"text-left font-weight-bolder\" href=\"#\"  data-toggle=\"collapse\" data-target=\"#pnotes_ps_expand\"  aria-expanded=\"true\" aria-controls=\"pnotes_ps_expand\">Messages<i class=\"ml-1 fa fa-fw  fa-expand \" data-target=\"#pnotes_ps_expand\"></i></a>\n                            <span>\n                                                    <a class=\"\" href=\"pnotes_full.php?form_active=1\"  ><i class=\"fa fa-pencil-alt\">&nbsp;</i></a>\n                                </span>\n                    </h6>\n        <div id=\"pnotes_ps_expand\" class=\"card-text collapse\">\n            <div class=\"clearfix pt-2\">\n                <div class=\"text ml-2\">\n    <div class=\"spinner-border spinner-border-sm\" role=\"status\">\n        <span class=\"sr-only\">Loading...</span>\n    </div>\n</div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"card \">\n    <div class=\"card-body p-1\">\n        <h6 class=\"card-title mb-0 d-flex p-1 justify-content-between\">\n            <a class=\"text-left font-weight-bolder\" href=\"#\"  data-toggle=\"collapse\" data-target=\"#patient_reminders_ps_ex