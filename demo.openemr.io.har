            "compression": 0,
            "text": "\n<script>\n    if(typeof load_location === 'undefined') {\n        function load_location(location) {\n            top.restoreSession();\n            document.location = location;\n        }\n    }\n</script>\n\n<section class=\"card \">\n    <div class=\"card-body p-1\">\n        <h6 class=\"card-title mb-0 d-flex p-1 justify-content-between\">\n            <a class=\"text-left font-weight-bolder\" href=\"#\"  data-toggle=\"collapse\" data-target=\"#health_concern_ps_expand\"  aria-expanded=\"true\" aria-controls=\"health_concern_ps_expand\">Health Concerns<i class=\"ml-1 fa fa-fw  fa-compress \" data-target=\"#health_concern_ps_expand\"></i></a>\n                            <span>\n                                                    <a class=\"\" href=\"#\"  onclick=\"return load_location('/openemr/interface/patient_file/summary/stats_full.php?active=all&category=health_concern')\"><i class=\"fa fa-pencil-alt\">&nbsp;</i></a>\n                                </span>\n                    </h6>\n        <div id=\"health_concern_ps_expand\" class=\"card-text collapse show\">\n            <div class=\"clearfix pt-2\">\n                \n<div class=\"list-group list-group-flush pami-list\">\n        <div class=\"list-group-item p-0 pl-1\">\n        Nothing Recorded\n    </div>\n    </div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"card \">\n    <div class=\"card-body p-1\">\n        <h6 class=\"card-title mb-0 d-flex p-1 justify-content-between\">\n            <a class=\"text-left font-weight-bolder\" href=\"#\"  data-toggle=\"collapse\" data-target=\"#immunizations_ps_expand\"  aria-expanded=\"true\" aria-controls=\"immunizations_ps_expand\">Immunizations<i class=\"ml-1 fa fa-fw  fa-compress \" data-target=\"#immunizations_ps_expand\"></i></a>\n                            <span>\n                                                    <a class=\"\" href=\"immunizations.php\"  ><i class=\"fa fa-pencil-alt\">&nbsp;</i></a>\n                                </span>\n                    </h6>\n        <div id=\"immunizations_ps_expand\" class=\"card-text collapse show\">\n            <div class=\"clearfix pt-2\">\n                <div class=\"list-group list-group-flush imz\">\n    <div class=\"list-group-item d-flex w-100\">\n        None\n    </div>\n</div>\n            </div>\n        </div>\n    </div>\n</section>\n"
          },
