        "connection": "443",
        "request": {
          "method": "GET",
          "url": "https://demo.openemr.io/openemr/public/assets/jquery-datetimepicker/build/jquery.datetimepicker.full.min.js?v=82",
          "httpVersion": "http/1.1",
