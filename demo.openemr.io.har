ard\">\n    <div class=\"card-header p-0 bg-secondary\" id=\"header_6\">\n        <h2 class=\"mb-0\">\n            <button class=\"btn btn-link btn-block text-light text-left\" type=\"button\" data-toggle=\"collapse\" data-target=\"#div_6\" aria-expanded=\"true\" aria-controls=\"6\">Misc</button>\n        </h2>\n    </div>\n    <div id=\"div_6\" class=\"bg-light collapse \" aria-labelledby=\"header_6\" >\n        <div class=\"container-xl card-body\"><div class='form-group row'><div class='col-12 col-md-auto col-lg-3 ' id='label_deceased_date'>Date Deceased:</div><div class='col-12 col-md-auto col-lg-9' id='text_deceased_date'><input type='text' size='10' class='datepicker form-control form-control-sm mw-100' name='form_deceased_date' id='form_deceased_date' value='' title='If person is deceased, then enter date of death.'  onchange='checkSkipConditions();'  /></div></div><!-- End BS row -->\n<div class='form-group row'><div class='col-12 col-md-auto col-lg-3 ' id='label_deceased_reason'>Reason Deceased:</div><div class='col-12 col-md-auto col-lg-9' id='text_deceased_reason'><input type='text'\n            class='form-control form-control-sm mw-100'\n            name='form_deceased_reason'\n            id='form_deceased_reason'\n            size='30'\n            maxlength='255'\n            \n            title='Reason for Death'\n            value='' onchange='checkSkipConditions();' /></div></div><!-- End BS row -->\n</div>\n</div>\n</div><div class=\"card\">\n    <div class=\"card-header p-0 bg-secondary\" id=\"header_7\">\n        <h2 class=\"mb-0\">\n            <button class=\"btn btn-link btn-block text-light text-left\" type=\"button\" data-toggle=\"collapse\" data-target=\"#div_7\" aria-expanded=\"true\" aria-controls=\"7\">Related</button>\n        </h2>\n    </div>\n    <div id=\"div_7\" class=\"bg-light collapse \" aria-labelledby=\"header_7\" >\n        <div class=\"container-xl card-body\"><div class='form-group row'><div class='col-12 col-md-auto col-