           <label class='col-form-label col-md-1 mb-2'>Subscriber Phone:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='text' class='form-control' size='20' name='i2subscriber_phone' value='' onkeyup='phonekeyup(this,mypcc)' />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2'>Co-Pay:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='text' class='form-control' size=\"6\" name='i2copay' value=\"\" />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Accept Assignment:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <select class='form-control' name='i2accept_assignment'>\n                                <option value=\"TRUE\" >YES</option>\n                                <option value=\"FALSE\" >NO</option>\n                            </select>\n                          </div>\n                        </div>\n                        <hr />\n                                                    <div class=\"row p-3\">\n                          <div class=\"col-md-12 mb-2\">\n                            <div class=\"input-group\">\n                              <label class='col-form-label mr-2 required'>Tertiary Insurance provider:</label>\n                              <select name=\"i3provider\" class=\"form-control\">\n                                  <option value=\"\">Unassigned</option>\n                                  <option value='2'>Aekna</option>\n<option value='36'>CarolinaCare Health Plan </option>\n<option value='17'>Franziska Viktoria Haydanek</option>\n                              </select>\n                              <div class=\"input-group-append\">\n                                <a class='btn btn-primary text-white medium_modal' href='../practice/ins_search.php' onclick='ins_search(3)'>Search/Add Insurer</a>\n                              </div>\n                            </div>\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Plan Name:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='20' name='i3plan_name' value=\"\" onchange=\"capitalizeMe(this);\" />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Subscriber:</label>\n                          <div class=\"col-md-5 mb-2 form-inline\">\n                            <input type='entry' class='form-control' size='10' name='i3subscriber_fname' value=\"\" onchange=\"capitalizeMe(this);\" />\n                            <input type='entry' class='form-control' size='3' name='i3subscriber_mname' value=\"\" onchange=\"capitalizeMe(this);\" />\n                            <input type='entry' class='form-control' size='10' name='i3subscriber_lname' value=\"\" onchange=\"capitalizeMe(this);\" />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Effective Date: </label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' size='11' class='datepicker form-control' name='i3effective_date' id='i3effective_date' value='' />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Relationship:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <select name=\"form_i3subscriber_relationship\"\nid=\"form_i3subscriber_relationship\"\nclass=\"form-control  form-control-sm\"\ntitle=\"\"><option value=\"\" selected> </option>\n<option value=\"self\" >Self</option>\n<option value=\"spouse\" >Spouse</option>\n<option value=\"child\" >Child</option>\n<option value=\"other\" >Other</option></select>                            <a href=\"javascript:popUp('../../interface/patient_file/summary/browse.php?browsenum=3')\" class='text'>(Browse)</a>\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Policy Number:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='16' name='i3policy_number' value=\"\" onkeyup='policykeyup(this)' />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2'>D.O.B.:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' size='11' class='datepicker-past form-control' name='i3subscriber_DOB' id='i3subscriber_DOB' value='' />\n                          </div>\n                          <label class='col-form-label col-md-1 required'>Group Number:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='16' name='i3group_number' value=\"\" onkeyup='policykeyup(this)' />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2'>S.S.:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='11' name='i3subscriber_ss' value=\"\" />\n                          </div>\n                                                        <label class=\"col-form-label col-md-1 mb-2 required\">Subscriber Employer (SE):</label>\n                            <div class=\"col-md-5 mb-2\">\n                              <input type='entry' class='form-control' aria-describedby=\"seHelpBlock\" size='25' name='i3subscriber_employer' value=\"\" onchange=\"capitalizeMe(this);\" />\n                              <small id=\"seHelpBlock\" class=\"form-text text-muted\">\n                                if unemployed enter Student, PT Student, or leave blank.\n                              </small>\n                            </div>\n                                                      <label class='col-form-label col-md-1 mb-2'>Sex:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <select name=\"form_i3subscriber_sex\"\nid=\"form_i3subscriber_sex\"\nclass=\"form-control  form-control-sm\"\ntitle=\"\"><option value=\"\" selected>Unassigned</option>\n<option value=\"Female\" >Female</option>\n<option value=\"Male\" >Male</option>\n<option value=\"UNK\" >Unknown</option></select>                          </div>\n                                                        <label class='col-form-label col-md-1 mb-2 required'>SE Address:</label>\n                            <div class=\"col-md-5 mb-2\">\n                              <input type='entry' class='form-control' size='25' name='i3subscriber_employer_street' value=\"\" onchange=\"capitalizeMe(this);\" />\n                            </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>Subscriber Address Line 1:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='25' name='i3subscriber_street' value=\"\" onchange=\"capitalizeMe(this);\" />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Subscriber Address Line 2:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='25' name='i3subscriber_street_line_2' value=\"\" onchange=\"capitalizeMe(this);\" />\n                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>SE City:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='15' name='i3subscriber_employer_city' value=\"\" onchange=\"capitalizeMe(this);\" />\n                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>City:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='15' name='i3subscriber_city' value=\"\" onchange=\"capitalizeMe(this);\" />\n                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>SE State:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <div class='input-group'><select name=\"form_i3subscriber_employer_state\"\nid=\"form_i3subscriber_employer_state\"\nclass=\"form-control addtolistclass_state form-control-sm\"\ntitle=\"\"><option value=\"\" selected>Unassigned</option>\n<option value=\"AL\" >Alabama</option>\n<option value=\"AK\" >Alaska</option>\n<option value=\"AZ\" >Arizona</option>\n<option value=\"AR\" >Arkansas</option>\n<option value=\"CA\" >California</option>\n<option value=\"CO\" >Colorado</option>\n<option value=\"CT\" >Connecticut</option>\n<option value=\"DE\" >Delaware</option>\n<option value=\"DC\" >District of Columbia</option>\n<option value=\"FL\" >Florida</option>\n<option value=\"GA\" >Georgia</option>\n<option value=\"HI\" >Hawaii</option>\n<option value=\"ID\" >Idaho</option>\n<option value=\"IL\" >Illinois</option>\n<option value=\"IN\" >Indiana</option>\n<option value=\"IA\" >Iowa</option>\n<option value=\"KS\" >Kansas</option>\n<option value=\"KY\" >Kentucky</option>\n<option value=\"LA\" >Louisiana</option>\n<option value=\"ME\" >Maine</option>\n<option value=\"MD\" >Maryland</option>\n<option value=\"MA\" >Massachusetts</option>\n<option value=\"MI\" >Michigan</option>\n<option value=\"MN\" >Minnesota</option>\n<option value=\"MS\" >Mississippi</option>\n<option value=\"MO\" >Missouri</option>\n<option value=\"MT\" >Montana</option>\n<option value=\"NE\" >Nebraska</option>\n<option value=\"NV\" >Nevada</option>\n<option value=\"NH\" >New Hampshire</option>\n<option value=\"NJ\" >New Jersey</option>\n<option value=\"NM\" >New Mexico</option>\n<option value=\"NY\" >New York</option>\n<option value=\"NC\" >North Carolina</option>\n<option value=\"ND\" >North Dakota</option>\n<option value=\"OH\" >Ohio</option>\n<option value=\"OK\" >Oklahoma</option>\n<option value=\"OR\" >Oregon</option>\n<option value=\"PA\" >Pennsylvania</option>\n<option value=\"PR\" >Puerto Rico</option>\n<option value=\"RI\" >Rhode Island</option>\n<option value=\"SC\" >South Carolina</option>\n<option value=\"SD\" >South Dakota</option>\n<option value=\"TN\" >Tennessee</option>\n<option value=\"TX\" >Texas</option>\n<option value=\"UT\" >Utah</option>\n<option value=\"VT\" >Vermont</option>\n<option value=\"VA\" >Virginia</option>\n<option value=\"WA\" >Washington</option>\n<option value=\"WV\" >West Virginia</option>\n<option value=\"WI\" >Wisconsin</option>\n<option value=\"WY\" >Wyoming</option></select><div class='input-group-append'><input type='button' class='btn btn-secondary btn-sm mb-1 addtolist' id='addtolistid_state' fieldid='form_i3subscriber_employer_state' value='Add'  /></div></div>                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>State:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <div class='input-group'><select name=\"form_i3subscriber_state\"\nid=\"form_i3subscriber_state\"\nclass=\"form-control addtolistclass_state form-control-sm\"\ntitle=\"\"><option value=\"\" selected>Unassigned</option>\n<option value=\"AL\" >Alabama</option>\n<option value=\"AK\" >Alaska</option>\n<option value=\"AZ\" >Arizona</option>\n<option value=\"AR\" >Arkansas</option>\n<option value=\"CA\" >California</option>\n<option value=\"CO\" >Colorado</option>\n<option value=\"CT\" >Connecticut</option>\n<option value=\"DE\" >Delaware</option>\n<option value=\"DC\" >District of Columbia</option>\n<option value=\"FL\" >Florida</option>\n<option value=\"GA\" >Georgia</option>\n<option value=\"HI\" >Hawaii</option>\n<option value=\"ID\" >Idaho</option>\n<option value=\"IL\" >Illinois</option>\n<option value=\"IN\" >Indiana</option>\n<option value=\"IA\" >Iowa</option>\n<option value=\"KS\" >Kansas</option>\n<option value=\"KY\" >Kentucky</option>\n<option value=\"LA\" >Louisiana</option>\n<option value=\"ME\" >Maine</option>\n<option value=\"MD\" >Maryland</option>\n<option value=\"MA\" >Massachusetts</option>\n<option value=\"MI\" >Michigan</option>\n<option value=\"MN\" >Minnesota</option>\n<option value=\"MS\" >Mississippi</option>\n<option value=\"MO\" >Missouri</option>\n<option value=\"MT\" >Montana</option>\n<option value=\"NE\" >Nebraska</option>\n<option value=\"NV\" >Nevada</option>\n<option value=\"NH\" >New Hampshire</option>\n<option value=\"NJ\" >New Jersey</option>\n<option value=\"NM\" >New Mexico</option>\n<option value=\"NY\" >New York</option>\n<option value=\"NC\" >North Carolina</option>\n<option value=\"ND\" >North Dakota</option>\n<option value=\"OH\" >Ohio</option>\n<option value=\"OK\" >Oklahoma</option>\n<option value=\"OR\" >Oregon</option>\n<option value=\"PA\" >Pennsylvania</option>\n<option value=\"PR\" >Puerto Rico</option>\n<option value=\"RI\" >Rhode Island</option>\n<option value=\"SC\" >South Carolina</option>\n<option value=\"SD\" >South Dakota</option>\n<option value=\"TN\" >Tennessee</option>\n<option value=\"TX\" >Texas</option>\n<option value=\"UT\" >Utah</option>\n<option value=\"VT\" >Vermont</option>\n<option value=\"VA\" >Virginia</option>\n<option value=\"WA\" >Washington</option>\n<option value=\"WV\" >West Virginia</option>\n<option value=\"WI\" >Wisconsin</option>\n<option value=\"WY\" >Wyoming</option></select><div class='input-group-append'><input type='button' class='btn btn-secondary btn-sm mb-1 addtolist' id='addtolistid_state' fieldid='form_i3subscriber_state' value='Add'  /></div></div>                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>SE Zip Code: </label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='10' name='i3subscriber_employer_postal_code' value=\"\" />\n                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>Zip Code: </label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='entry' class='form-control' size='10' name='i3subscriber_postal_code' value=\"\" />\n                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2 required'>SE Country:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <div class='input-group'><select name=\"form_i3subscriber_employer_country\"\nid=\"form_i3subscriber_employer_country\"\nclass=\"form-control addtolistclass_country form-control-sm\"\ntitle=\"\"><option value=\"\" selected>Unassigned</option>\n<option value=\"USA\" >USA</option></select><div class='input-group-append'><input type='button' class='btn btn-secondary btn-sm mb-1 addtolist' id='addtolistid_country' fieldid='form_i3subscriber_employer_country' value='Add'  /></div></div>                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Country:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <div class='input-group'><select name=\"form_i3subscriber_country\"\nid=\"form_i3subscriber_country\"\nclass=\"form-control addtolistclass_country form-control-sm\"\ntitle=\"\"><option value=\"\" selected>Unassigned</option>\n<option value=\"USA\" >USA</option></select><div class='input-group-append'><input type='button' class='btn btn-secondary btn-sm mb-1 addtolist' id='addtolistid_country' fieldid='form_i3subscriber_country' value='Add'  /></div></div>                          </div>\n                                                      <label class='col-form-label col-md-1 mb-2'>Subscriber Phone:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='text' class='form-control' size='20' name='i3subscriber_phone' value='' onkeyup='phonekeyup(this,mypcc)' />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2'>Co-Pay:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <input type='text' class='form-control' size=\"6\" name='i3copay' value=\"\" />\n                          </div>\n                          <label class='col-form-label col-md-1 mb-2 required'>Accept Assignment:</label>\n                          <div class=\"col-md-5 mb-2\">\n                            <select class='form-control' name='i3accept_assignment'>\n                                <option value=\"TRUE\" >YES</option>\n                                <option value=\"FALSE\" >NO</option>\n                            </select>\n                          </div>\n                        </div>\n                        <hr />\n                            </div>\n\n                    \n                            </td>\n                            <td class=\"text-right align-top text-nowrap\" width='1%'>\n                            <!-- Image upload stuff was here but got moved. -->\n                            </td>\n                        </tr>\n                    </table>\n                </form>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-md-12\">\n                <div class=\"btn-group\">\n                                            <button type=\"button\" class=\"btn btn-secondary btn-search\" id=\"search\" value=\"Search\">\n                            Search                        </button>\n                                        <button type=\"button\" class=\"btn btn-primary btn-save\" name='create' id=\"create\" value=\"Create New Patient\">\n                        Create New Patient                    </button>\n                </div>\n            </div>\n        </div>\n    </div> <!--end of container div -->\n<!-- include support for the list-add selectbox feature -->\n\n\n<!-- hidden DIV used for creating new list items -->\n<div id=\"newlistitem\" class=\"position-absolute bg-light border border-dark\" style=\"display: none; padding: 5px; z-index: 5000;\">\n <input type=\"hidden\" name=\"newlistitem_listid\" id=\"newlistitem_listid\" value=\"\" />\n <input type=\"hidden\" name=\"newlistitem_fieldid\" id=\"newlistitem_fieldid\" value=\"\" />\n <div id=\"specificForm\">\n </div>\n <div class=\"text-center\">\n  <div style='margin-top: 0.5rem;'>\n   <input type='button' class='btn btn-primary' name='newlistitem_submit' id='newlistitem_submit' value='Add' />\n   <input type='button' class='btn btn-secondary' name='newlistitem_cancel' id='newlistitem_cancel' value='Cancel' />\n  </div>\n </div>\n</div>\n\n\n<script>\n\n    // collect the custom state widget flag\n    var stateCustomFlag = true;\n\n    // generic form for input box\n    var generic = \"<input type='text' class='form-control' name='newlistitem_value' id='newlistitem_value' size='20' maxlength='50' />\";\n\n    // state form for input box\n    var state   = \"\\\n<ul class='m-0 p-0 list-unstyled'>\\\n <li class='text-center font-weight-bold' style='font-size:120%;'>\\\n    Enter new State</li>\\\n <li class='p-0' style='margin-top: 0.5rem;'>\\\n    Full Name:\\\n  <input type='text' class='form-control' name='newlistitem_value' id='newlistitem_value' size='20' maxlength='50' /><li>\\\n <li class='p-0' style='margin-top: 0.5rem;'>\\\n    Abbreviation:\\\n  <input type='text' class='form-control' name='newlistitem_abbr' id='newlistitem_abbr' size='10' maxlength='50' /><li>\\\n</ul>\\\n\";\n\n// jQuery makes life easier (sometimes)\n\n$(function () {\n\n    /********************************************************/\n    /************ List-box modification functions ***********/\n    /********************************************************/\n\n    $(\"#newlistitem\").on(\"keypress\", function(evt) { if (evt.keyCode == 13) { SaveNewListItem(this, evt); return false; }});\n    $(\".addtolist\").on(\"click\", function(evt) { AddToList(this, evt); });\n    $(\"#newlistitem_submit\").on(\"click\", function(evt) { SaveNewListItem(this, evt); });\n    $(\"#newlistitem_cancel\").on(\"click\", function(evt) { CancelAddToList(this, evt); });\n\n    // display the 'new list item' DIV at the mouse position\n    var AddToList = function(btnObj, e) {\n        // capture the ID of the list and specific field being modified from the object's ID\n        $('#newlistitem_listid').val($(btnObj).attr(\"id\").replace(/^addtolistid_/g, \"\"));\n        $('#newlistitem_fieldid').val($(btnObj).attr(\"fieldid\"));\n\n        // REMOVE previous form\n    $(\"#specificForm\").empty();\n\n    // INSERT the selected form\n    if (($(\"#newlistitem_listid\").val() == \"state\") && (stateCustomFlag)) {\n     // insert state form and clear values\n         $(\"#specificForm\").append(state);\n         $('#newlistitem_value').val(\"\");\n         $('#newlistitem_abbr').val(\"\");\n    }\n    else {\n     // insert generic form and clear values\n     $(\"#specificForm\").append(generic);\n     $('#newlistitem_value').val(\"\");\n        }\n\n        // make the item visible before setting its x,y location\n        $('#newlistitem').css('display', 'inline');\n        //getting height and width of the message box\n        var height = $('#newlistitem').height();\n        var width = $('#newlistitem').width();\n        //calculating offset for displaying popup message\n        leftVal = e.pageX - (width / 2) + \"px\";\n        topVal = e.pageY - (height / 2) + \"px\";\n        //show the DIV and set cursor focus\n        $('#newlistitem').css({left:leftVal,top:topVal}).show();\n        $('#newlistitem_value').focus();\n    };\n\n    // hide the add-to-list DIV and clear its textbox\n    var CancelAddToList = function(btnObj, e) {\n        $('#newlistitem').hide();\n    }\n\n    // save the new list item to the given list\n    var SaveNewListItem = function(btnObj, e) {\n    // VALIDATE the selected form\n        //  Don't allow a number as first character\n        //  Don't allow illegal characters (' and \" for now) - still developing\n    //   First, validate fields common to all forms\n        if ($(\"#newlistitem_value\").val().match(/^\\d/)) {\n            alert(\"List items can not start with a number.\");\n            $(\"#newlistitem_value\").focus();\n            return false;\n        }\n        if ($(\"#newlistitem_value\").val().match(/[\\'\\\"]/)) {\n            alert(\"List items contains illegal character(s).\");\n            $(\"#newlistitem_value\").focus();\n            return false;\n        }\n    //  Second, validate form specific fields\n        if (($(\"#newlistitem_listid\").val() == \"state\") && (stateCustomFlag)) {\n            // state forms specific validation\n            if ($(\"#newlistitem_abbr\").val().match(/^\\d/)) {\n                alert(\"List items can not start with a number.\");\n                $(\"#newlistitem_abbr\").focus();\n                return false;\n            }\n            if ($(\"#newlistitem_abbr\").val().match(/[\\'\\\"]/)) {\n                alert(\"List items contains illegal character(s).\");\n                $(\"#newlistitem_abbr\").focus();\n                return false;\n            }\n        }\n\n        // PROCESS the selected form\n        if (($(\"#newlistitem_listid\").val() == \"state\") && (stateCustomFlag)) {\n        // process state form\n        //  (note we have collected a title and abbreviation)\n        var listid = $(\"#newlistitem_listid\").val();\n        var newitem = $('#newlistitem_value').val();\n        var newitem_abbr = $('#newlistitem_abbr').val();\n\n    }\n    else {\n        // process generic form\n        //  (note we have only collected the title, so will make\n        //   abbreviation same as title)\n        var listid = $(\"#newlistitem_listid\").val();\n        var newitem = $('#newlistitem_value').val();\n        var newitem_abbr = $('#newlistitem_value').val();\n    }\n\n        // make the AJAX call to save the new value to the specified list\n        // upon returning successfully, refresh the list box and select\n        // the new list item\n        $.getJSON(\"/openemr/library/ajax/addlistitem.php\",\n                    {csrf_token_form: \"84ff308cef1af427e2aba67609794319de7077dc\",\n                    listid: listid,\n             newitem: newitem,\n             newitem_abbr: newitem_abbr},\n                    function(jsondata, txtresponse) {\n                 if( jsondata.error == '' ){\n              //process each widget with the same list\n            $(\"select.addtolistclass_\"+listid).each(function(){\n                var pointer = $(this);\n                var currentselected = pointer.val();\n                var listboxfield = pointer.attr(\"id\");\n                var listbox = document.getElementById(listboxfield);\n                            while (listbox.options.length > 0) { listbox.options[0] = null; }\n                            $.each(jsondata.options, function () {\n                    if (listboxfield == $('#newlistitem_fieldid').val()) {\n                    // build select for the chosen widget field\n                                    listbox.options[listbox.options.length] = new Option(this.title, this.id);\n                                    if (this.id == newitem_abbr) {\n                        pointer.val(this.id);\n                                    }\n                }\n                else {\n                    // build select for the other widgets using the same list\n                    listbox.options[listbox.options.length] = new Option(this.title, this.id);\n                    if (this.id == currentselected) {\n                      pointer.val(currentselected);\n                    }\n                }\n              });\n            });\n            // now hide the DIV\n            $('#newlistitem').hide();\n             } else {\n               alert(jsondata.error);\n             }\n           }\n         );\n\n    }  // end SaveNewListItem\n\n    // let's expose some of these options so that others can use them if they are using the options.inc.php piece\n    let optionWidgets = {\n        CancelAddToList: CancelAddToList\n        ,AddToList: AddToList\n        ,SaveNewListItem: SaveNewListItem\n    };\n\n    if (!window.oeUI) {\n        window.oeUI = {};\n    }\n    window.oeUI.optionWidgets = optionWidgets;\n\n}); // end jQuery .ready\n</script>\n<script>\n\n// hard code validation for old validation, in the new validation possible to add match rules\n\n\n// -=- jQuery makes life easier -=-\n\n// var matches = 0; // number of patients that match the demographic information being entered\n// var override = false; // flag that overrides the duplication warning\n\n$(function () {\n    $(\".medium_modal\").on('click', function(e) {\n        e.preventDefault();e.stopPropagation();\n        dlgopen('', '', 650, 460, '', '', {\n            buttons: [\n                {text: \"Close\", close: true, style: 'default btn-sm'}\n            ],\n            //onClosed: 'refreshme',\n            allowResize: false,\n            allowDrag: true,\n            dialogId: '',\n            type: 'iframe',\n            url: $(this).attr('href')\n        });\n    });\n    // added to integrate insurance stuff\n        $(\"#form_i1subscriber_relationship\").change(function() { auto_populate_employer_address1(); });\n        $(\"#form_i2subscriber_relationship\").change(function() { auto_populate_employer_address2(); });\n        $(\"#form_i3subscriber_relationship\").change(function() { auto_populate_employer_address3(); });\n    \n    $('#search').click(function() { searchme(); });\n    $('#create').click(function() { check()});\n\n    var check = function(e) {\n        var f = document.forms[0];\n                    var valid = submitme(1, e, \"DEM\", constraints);\n                if (valid) {\n            if (force_submit) {\n                // In this case dups were shown already and Save should just save.\n                top.restoreSession();\n                f.submit();\n                return;\n            }\n\n                            // Build and invoke the URL to create the dup-checker dialog.\n            var url = 'new_search_popup.php';\n        \n        var flds = new Array(\"fname\",\"mname\",\"lname\",\"suffix\",\"preferred_name\",\"DOB\",\"birth_fname\",\"birth_mname\",\"birth_lname\",\"name_history\",\"patient_groups\",\"financial_review\",\"interpreter_needed\",\"deceased_date\");\n        var separator = '?';\n        for (var i = 0; i < flds.length; ++i) {\n            var fval = $('#form_' + flds[i]).val();\n            if (fval && fval != '') {\n                url += separator;\n                separator = '&';\n                url += 'mf_' + flds[i] + '=' + encodeURIComponent(fval);\n            }\n        }\n        if (flds == '') {\n            url += \"?close\";\n        } else {\n            url+=\"&close\";\n        }\n        dlgopen(url, '_blank', 875, 500);\n        } // end function\n    } // end function\n\n// Set onclick/onfocus handlers for toggling background color.\n    $(\"#form_title\").click(function() { selClick(this); });\n    $(\"#form_title\").blur(function() { selBlur(this); });\n    $(\"#form_fname\").click(function() { toggleSearch(this); });\n    $(\"#form_mname\").click(function() { toggleSearch(this); });\n    $(\"#form_lname\").click(function() { toggleSearch(this); });\n    $(\"#form_suffix\").click(function() { toggleSearch(this); });\n    $(\"#form_preferred_name\").click(function() { toggleSearch(this); });\n    $(\"#form_pubpid\").click(function() { toggleSearch(this); });\n    $(\"#form_DOB\").click(function() { toggleSearch(this); });\n    $(\"#form_sex\").click(function() { selClick(this); });\n    $(\"#form_sex\").blur(function() { selBlur(this); });\n    $(\"#form_ss\").click(function() { toggleSearch(this); });\n    $(\"#form_drivers_license\").click(function() { toggleSearch(this); });\n    $(\"#form_status\").click(function() { selClick(this); });\n    $(\"#form_status\").blur(function() { selBlur(this); });\n    $(\"#form_genericname1\").click(function() { toggleSearch(this); });\n    $(\"#form_genericval1\").click(function() { toggleSearch(this); });\n    $(\"#form_genericname2\").click(function() { toggleSearch(this); });\n    $(\"#form_genericval2\").click(function() { toggleSearch(this); });\n    $(\"#form_billing_note\").click(function() { toggleSearch(this); });\n    $(\"#form_sex_identified\").click(function() { selClick(this); });\n    $(\"#form_sex_identified\").blur(function() { selBlur(this); });\n    $(\"#form_pronoun\").click(function() { selClick(this); });\n    $(\"#form_pronoun\").blur(function() { selBlur(this); });\n    $(\"#form_birth_fname\").click(function() { toggleSearch(this); });\n    $(\"#form_birth_mname\").click(function() { toggleSearch(this); });\n    $(\"#form_birth_lname\").click(function() { toggleSearch(this); });\n    $(\"#form_street\").click(function() { toggleSearch(this); });\n    $(\"#form_street_line_2\").click(function() { toggleSearch(this); });\n    $(\"#form_city\").click(function() { toggleSearch(this); });\n    $(\"#form_state\").click(function() { selClick(this); });\n    $(\"#form_state\").blur(function() { selBlur(this); });\n    $(\"#form_postal_code\").click(function() { toggleSearch(this); });\n    $(\"#form_country_code\").click(function() { selClick(this); });\n    $(\"#form_country_code\").blur(function() { selBlur(this); });\n    $(\"#form_mothersname\").click(function() { toggleSearch(this); });\n    $(\"#form_contact_relationship\").click(function() { toggleSearch(this); });\n    $(\"#form_phone_contact\").click(function() { toggleSearch(this); });\n    $(\"#form_phone_home\").click(function() { toggleSearch(this); });\n    $(\"#form_phone_biz\").click(function() { toggleSearch(this); });\n    $(\"#form_phone_cell\").click(function() { toggleSearch(this); });\n    $(\"#form_email\").click(function() { toggleSearch(this); });\n    $(\"#form_email_direct\").click(function() { toggleSearch(this); });\n    $(\"#form_county\").click(function() { selClick(this); });\n    $(\"#form_county\").blur(function() { selBlur(this); });\n    $(\"#form_providerID\").click(function() { selClick(this); });\n    $(\"#form_providerID\").blur(function() { selBlur(this); });\n    $(\"#form_provider_since_date\").click(function() { toggleSearch(this); });\n    $(\"#form_ref_providerID\").click(function() { selClick(this); });\n    $(\"#form_ref_providerID\").blur(function() { selBlur(this); });\n    $(\"#form_pharmacy_id\").click(function() { selClick(this); });\n    $(\"#form_pharmacy_id\").blur(function() { selBlur(this); });\n    $(\"#form_hipaa_notice\").click(function() { selClick(this); });\n    $(\"#form_hipaa_notice\").blur(function() { selBlur(this); });\n    $(\"#form_hipaa_voice\").click(function() { selClick(this); });\n    $(\"#form_hipaa_voice\").blur(function() { selBlur(this); });\n    $(\"#form_hipaa_message\").click(function() { toggleSearch(this); });\n    $(\"#form_hipaa_mail\").click(function() { selClick(this); });\n    $(\"#form_hipaa_mail\").blur(function() { selBlur(this); });\n    $(\"#form_hipaa_allowsms\").click(function() { selClick(this); });\n    $(\"#form_hipaa_allowsms\").blur(function() { selBlur(this); });\n    $(\"#form_hipaa_allowemail\").click(function() { selClick(this); });\n    $(\"#form_hipaa_allowemail\").blur(function() { selBlur(this); });\n    $(\"#form_allow_imm_reg_use\").click(function() { selClick(this); });\n    $(\"#form_allow_imm_reg_use\").blur(function() { selBlur(this); });\n    $(\"#form_allow_imm_info_share\").click(function() { selClick(this); });\n    $(\"#form_allow_imm_info_share\").blur(function() { selBlur(this); });\n    $(\"#form_allow_health_info_ex\").click(function() { selClick(this); });\n    $(\"#form_allow_health_info_ex\").blur(function() { selBlur(this); });\n    $(\"#form_allow_patient_portal\").click(function() { selClick(this); });\n    $(\"#form_allow_patient_portal\").blur(function() { selBlur(this); });\n    $(\"#form_cmsportal_login\").click(function() { toggleSearch(this); });\n    $(\"#form_imm_reg_status\").click(function() { selClick(this); });\n    $(\"#form_imm_reg_status\").blur(function() { selBlur(this); });\n    $(\"#form_imm_reg_stat_effdate\").click(function() { toggleSearch(this); });\n    $(\"#form_publicity_code\").click(function() { selClick(this); });\n    $(\"#form_publicity_code\").blur(function() { selBlur(this); });\n    $(\"#form_publ_code_eff_date\").click(function() { toggleSearch(this); });\n    $(\"#form_protect_indicator\").click(function() { selClick(this); });\n    $(\"#form_protect_indicator\").blur(function() { selBlur(this); });\n    $(\"#form_prot_indi_effdate\").click(function() { toggleSearch(this); });\n    $(\"#form_occupation\").click(function() { selClick(this); });\n    $(\"#form_occupation\").blur(function() { selBlur(this); });\n    $(\"#form_industry\").click(function() { selClick(this); });\n    $(\"#form_industry\").blur(function() { selBlur(this); });\n    $(\"#form_language\").click(function() { selClick(this); });\n    $(\"#form_language\").blur(function() { selBlur(this); });\n    $(\"#form_family_size\").click(function() { toggleSearch(this); });\n    $(\"#form_financial_review\").click(function() { toggleSearch(this); });\n    $(\"#form_monthly_income\").click(function() { toggleSearch(this); });\n    $(\"#form_homeless\").click(function() { toggleSearch(this); });\n    $(\"#form_interpreter_needed\").click(function() { selClick(this); });\n    $(\"#form_interpreter_needed\").blur(function() { selBlur(this); });\n    $(\"#form_interpreter\").click(function() { toggleSearch(this); });\n    $(\"#form_migrantseasonal\").click(function() { toggleSearch(this); });\n    $(\"#form_referral_source\").click(function() { selClick(this); });\n    $(\"#form_referral_source\").blur(function() { selBlur(this); });\n    $(\"#form_vfc\").click(function() { selClick(this); });\n    $(\"#form_vfc\").blur(function() { selBlur(this); });\n    $(\"#form_religion\").click(function() { selClick(this); });\n    $(\"#form_religion\").blur(function() { selBlur(this); });\n    $(\"#form_tribal_affiliations\").click(function() { selClick(this); });\n    $(\"#form_tribal_affiliations\").blur(function() { selBlur(this); });\n    $(\"#form_deceased_date\").click(function() { toggleSearch(this); });\n    $(\"#form_deceased_reason\").click(function() { toggleSearch(this); });\n    $(\"#form_guardiansname\").click(function() { toggleSearch(this); });\n    $(\"#form_guardianrelationship\").click(function() { selClick(this); });\n    $(\"#form_guardianrelationship\").blur(function() { selBlur(this); });\n    $(\"#form_guardiansex\").click(function() { selClick(this); });\n    $(\"#form_guardiansex\").blur(function() { selBlur(this); });\n    $(\"#form_guardianaddress\").click(function() { toggleSearch(this); });\n    $(\"#form_guardiancity\").click(function() { toggleSearch(this); });\n    $(\"#form_guardianstate\").click(function() { selClick(this); });\n    $(\"#form_guardianstate\").blur(function() { selBlur(this); });\n    $(\"#form_guardianpostalcode\").click(function() { toggleSearch(this); });\n    $(\"#form_guardiancountry\").click(function() { selClick(this); });\n    $(\"#form_guardiancountry\").blur(function() { selBlur(this); });\n    $(\"#form_guardianphone\").click(function() { toggleSearch(this); });\n    $(\"#form_guardianworkphone\").click(function() { toggleSearch(this); });\n    $(\"#form_guardianemail\").click(function() { toggleSearch(this); });\n\n    $(\".select-dropdown\").select2({\n        theme: \"bootstrap4\",\n        dropdownAutoWidth: true,\n        width: 'resolve',\n        \"dir\":\"ltr\",\n\"language\": {\n    errorLoading: function () {\n        return \"The results could not be loaded\" + '.';\n    },\n    inputTooLong: function (args) {\n\n        return \"Please delete characters\";\n    },\n    inputTooShort: function (args) {\n\n        return \"Please enter more characters\";\n\n    },\n    loadingMore: function () {\n        return \"Loading more results\" + '...';\n    },\n    maximumSelected: function (args) {\n        var message = \"You can only select\" + ' ' + args.maximum;\n\n        if (args.maximum != 1) {\n            message += ' ' + \"items\";\n        } else {\n            message += ' ' + \"item\";\n        }\n\n        return message;\n    },\n    noResults: function () {\n        return \"No results found\";\n    },\n    searching: function () {\n        return \"Searching\" + '...';\n    }\n    },\n    });\n    if (typeof error !== 'undefined') {\n        if (error) {\n            alertMsg(error);\n        }\n    }\n\n  $('.datepicker').datetimepicker({\n                            i18n:{\n        en: {\n            months: [\n                \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"            ],\n            dayOfWeekShort: [\n                \"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"            ],\n            dayOfWeek: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"            ]\n        },\n    },\n        yearStart: '1900',\n    scrollInput: false,\n    scrollMonth: false,\n    rtl: false,\n                                format: 'Y-m-d',\n                timepicker:false\n          });\n  $('.datetimepicker').datetimepicker({\n                            i18n:{\n        en: {\n            months: [\n                \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"            ],\n            dayOfWeekShort: [\n                \"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"            ],\n            dayOfWeek: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"            ]\n        },\n    },\n        yearStart: '1900',\n    scrollInput: false,\n    scrollMonth: false,\n    rtl: false,\n                                                format: 'Y-m-d H:i',\n                formatTime: 'H:i',\n                validateOnBlur: false,\n                            timepicker:true,\n        step: 30\n          });\n  $('.datepicker-past').datetimepicker({\n                            i18n:{\n        en: {\n            months: [\n                \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"            ],\n            dayOfWeekShort: [\n                \"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"            ],\n            dayOfWeek: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"            ]\n        },\n    },\n        yearStart: '1900',\n    scrollInput: false,\n    scrollMonth: false,\n    rtl: false,\n                maxDate: '+1970/01/01',\n                            format: 'Y-m-d',\n                timepicker:false\n          });\n  $('.datetimepicker-past').datetimepicker({\n                            i18n:{\n        en: {\n            months: [\n                \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"            ],\n            dayOfWeekShort: [\n                \"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"            ],\n            dayOfWeek: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"            ]\n        },\n    },\n        yearStart: '1900',\n    scrollInput: false,\n    scrollMonth: false,\n    rtl: false,\n                maxDate: '+1970/01/01',\n                                            format: 'Y-m-d H:i',\n                formatTime: 'H:i',\n                validateOnBlur: false,\n                            timepicker:true,\n        step: 30\n          });\n  $('.datepicker-future').datetimepicker({\n                            i18n:{\n        en: {\n            months: [\n                \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"            ],\n            dayOfWeekShort: [\n                \"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"            ],\n            dayOfWeek: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"            ]\n        },\n    },\n        yearStart: '1900',\n    scrollInput: false,\n    scrollMonth: false,\n    rtl: false,\n            minDate: '-1970/01/01',\n                                format: 'Y-m-d',\n                timepicker:false\n          });\n  $('.datetimepicker-future').datetimepicker({\n                            i18n:{\n        en: {\n            months: [\n                \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"            ],\n            dayOfWeekShort: [\n                \"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"            ],\n            dayOfWeek: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"            ]\n        },\n    },\n        yearStart: '1900',\n    scrollInput: false,\n    scrollMonth: false,\n    rtl: false,\n            minDate: '-1970/01/01',\n                                                format: 'Y-m-d H:i',\n                formatTime: 'H:i',\n                validateOnBlur: false,\n                            timepicker:true,\n        step: 30\n          });\n\n\n}); // end document.ready\n\n// callback for new patient save confirm from new_search_popup.php\n// note that dlgclose() callbacks mostly need to init outside dom.\nfunction srcConfirmSave() {\n    document.forms[0].submit();\n}\n\n</script>\n\n    <script src=\"/openemr/public/assets/moment/moment.js\"></script>\n    <script src=\"/openemr/interface/../library/js/vendors/validate/validate_modified.js\"></script>\n    <script src=\"/openemr/interface/../library/js/vendors/validate/validate_extend.js\"></script>\n\n    <style type=\"text/css\">\n    .error-message {\n        position: absolute;\n        z-index: 1000;\n        background-color: #fff;\n        border: 1px solid var(--danger);\n        border-radius: 4px;\n        padding: 6px 12px;\n        max-width: 250px;\n        white-space: normal;\n        box-shadow: 0 2px 5px rgba(0,0,0,0.2);\n        color: var(--danger);\n        margin-top: 5px;\n    }\n    </style>\n    \n<script>\n    \n    var g_date_format='0';\n\nfunction submitme(new_validate,e,form_id, constraints) {\n\n        top.restoreSession();\n\n        //Use the old validation script if no parameter sent (backward compatibility)\n        //if we want to use the \"old\" validate function (set in globals) the validate function that will be called is the one that\n        // was on code up to today (the validate library was not loaded ( look at the top of this file)\n        if (new_validate !== 1) {\n            var f = document.forms[0];\n            if (validate(f)) {\n                somethingChanged = false;\n                f.submit();\n            } else { //If there was an error prevent the form submit in order to display them\n                e.preventDefault();\n            }\n        } else { //If the new validation library is used :\n\n            //Variables used for the validation library and validation mechanism\n            /*Get the constraint from the DB-> LBF forms accordinf the form_id*/\n            if(constraints==undefined || constraints=='') {\n                                 constraints = {\"form_fname\":{\"presence\":true},\"form_lname\":{\"presence\":true},\"form_DOB\":{\"presence\":true},\"form_sex\":{\"presence\":true}};\n            }\n            var valid = true ;\n\n            //We use a common error for all the errors because of the multilanguage capability of openemr\n            var form = document.querySelector(\"form#\"+form_id);\n            //gets all the \"elements\" in the form and sends them to the validate library\n            //for more information @see https://validatejs.org/\n            var elements = validate.collectFormValues(form);\n            var element, new_key;\n\n            //before catch all values - clear filed that in display none, this will enable to fail on this fields.\n            for(var key in elements){\n                    //catch th element with the name because the id of select-multiple contain '[]'\n                   // and jquery throws error in those situation\n                    element = $('[name=\"'+ key + '\"]');\n                    if(!$(element).is('select[multiple]')) {\n\n                            if($(element).parent().prop('style') != undefined && ($(element).parent().prop('style').visibility == 'hidden'|| element.parent().parent().css('display')== 'none')){\n                                $(element).val(\"\");\n                            }\n\n                    }\n                }\n\n            //get the input value after removing hide fields\n            elements = validate.collectFormValues(form);\n            //custom validate for multiple select(failed validate.js)\n            //the validate js cannot handle the LBF multiple select fields\n            for(var key in elements){\n\n                element = $('[name=\"'+ key + '\"]');\n\n                if($(element).is('select[multiple]')) {\n\n                    new_key = key.substring(0, key.length - 2);\n                    if(validate.isObject(constraints[new_key])) {\n                        //check if select multiple does empty (empty or unassigned)\n                        if(constraints[new_key].presence && (elements[key].length == 0 || elements[key][0] == null )) {\n\n                            appendError(element, new_key);\n                            e.preventDefault();\n                            valid = false;\n                        }\n                    }\n                    //remove multi select key to prevent errors\n                    delete elements[key];\n                    delete constraints[new_key];\n                }\n            }\n\n            //error contains an list of the elements and their errors\n            //set false full message because the name of the input not can be translated\n            var errors = validate(elements, constraints, {fullMessages: false});\n            if (typeof  errors !== 'undefined') {\n                //prevent default if trigger is submit button\n                if(typeof (e) !== 'undefined') {\n                    e.preventDefault();\n                }\n                showErrors(form, errors);\n                valid = false;\n            }else{\n                somethingChanged = false;\n            }\n\n            //In case there were errors they are displayed with this functionn\n            function showErrors(form, errors) {\n\n                for (var key in errors) {\n                    element = $('[name=\"'+ key + '\"]');\n                    if (errors.hasOwnProperty(key)) {\n                        appendError(element, key, errors[key][0])\n                    }\n                }\n            }\n            /**\n            * append 'span' with error message\n            */\n            function appendError(input, id, message){\n\n                //append 'span' tag for error massages if not exist\n                if($(\"#error_\" + id).length == 0) {\n                    //If have another element after the input\n                    if($(input).next().length > 0) {\n\n                        $(input).next().after(\"<span id='error_\" + id +\"' class='error-message' '></span>\");\n\n                    } else {\n                        $(input).after(\"<span id='error_\" + id +\"' class='error-message'></span>\");\n\n                    }\n                }\n                //show error message\n                //Validate.js enables to overwrite the error messages by adding 'message' to constraints json. if you want to use your custom message instead\n                //default message you need to add boolean property to the constraints json - 'custom_messages':true.\n                var error_msg = (typeof constraints.custom_messages !== 'undefined' && constraints.custom_messages) ? message : getErrorMessage(message);\n\n                var title= $(input).attr('title');\n                //if it's long title remove it from error message (this could destroy the UI)\n                if(title == undefined || title.length > 20) { title = \"\" }\n                $(\"#error_\" + id).text(title +' '+error_msg);\n\n                $(input).addClass('error-border');\n\n                //mark the tub\n                var parent_div = $(input).parents('div.tab');\n                if($(parent_div).is('div')) {\n                    var div_id = $(parent_div).attr('id');\n                    var type_tab = div_id.substr(4);\n                    $('a#header_tab_'+type_tab).css('color', 'var(--danger)');\n                 }\n\n                //open tab for new patient form\n                parent_div = $(input).parents('div.section');\n                if(parent_div !== undefined) {\n                    $(parent_div).css('display' , 'block');\n                    div_id = $(parent_div).attr('id');\n                    if(div_id !== undefined) {\n                        div_id = div_id.substr(-1);\n                        var input_checkbox = document.getElementById('form_cb_' + div_id);\n                        input_checkbox.checked = true;\n                    }\n                }\n\n                $(input).hover(\n                    function() {\n                        var $errorMsg = $(\"#error_\" + id);\n                        $errorMsg.show();\n                    },\n                    function() {\n                        $(\"#error_\" + id).hide();\n                    }\n                );\n\n                //bind hide function on focus/select again\n                $(input).on('click focus select', function(){\n                    hideErrors(this, id);\n                });\n                //for datepicker button\n                if($(input).next().is('img')){\n                    $(input).next().click(function(){\n\n                        hideErrors($(this).prev(), id);\n                    });\n                }\n\n                $(\"#error_\" + id).hide();\n\n            }\n            /*\n            * hide error message\n            * @param element\n            **/\n            function hideErrors(input, id){\n                $(input).removeClass('error-border');\n                $(\"#error_\" + id).remove();\n\n                var parent_div = $(input).parents('div.tab');\n                if($(parent_div).is('div')) {\n                    var div_id = $(parent_div).attr('id');\n                    var type_tab = div_id.substr(4);\n                    $('a#header_tab_'+type_tab).css('color', 'var(--black)');\n                }\n            }\n            /*\n            * Check if exist translation for current error message else return default message.\n            * In addition you can adding custom error message to the constraints json according validate.js instructions and add the translation here\n            * @param message\n            **/\n            function getErrorMessage(message){\n                //enable to translate error message\n                //todo - adding all the translations string from validate.js\n                // console.log(message);\n                switch (message){\n                    case 'Patient Name Required':\n                        return \"Patient Name Required\";\n                    case 'An end date later than the start date is required for repeated events!':\n                       return \"An end date later than the start date is required for repeated events!\";\n                    case 'Required field missing: Please enter the User Name':\n                        return \"Required field missing: Please enter the User Name\";\n                    case 'Please enter the password':\n                        return \"Please enter the password\";\n                    case 'Required field missing: Please enter the First name':\n                        return \"Required field missing: Please enter the First name\";\n                    case 'Required field missing: Please enter the Last name':\n                        return \"Required field missing: Please enter the Last name\";\n                    case 'Please choose a patient':\n                        return \"Please choose a patient\";\n                    case 'Must be future date':\n                        return \"Must be future date\";\n                    case 'Recipient required unless status is Done':\n                        return \"Recipient required unless status is Done\";\n                    case 'must have a valid hour (0-23)':\n                        return \"must have a valid hour (0-23)\";\n                    case 'Hour is required':\n                        return \"Hour is required\";\n                    case 'must have a valid minute (0-59)':\n                        return \"must have a valid minute (0-59)\";\n                    case 'Minute is required':\n                        return \"Minute is required\";\n                    case 'Must be a positive number':\n                        return \"Must be a positive number\";\n                    case 'Duration is required':\n                        return \"Duration is required\";\n                    default:\n                       return \"is not valid\";\n                }\n            }\n            //the result of validation\n            return valid;\n        }\n    }\n    //enable submit button until load submitme function\n    if(document.getElementById('submit_btn') != null) {\n        document.getElementById('submit_btn').disabled = false;\n    }\n</script>\n<script>\n    // Array of skip conditions for the checkSkipConditions() function.\n    var skipArray = [\n            ];\n    checkSkipConditions();\n    $(\"input\").change(function() {\n        checkSkipConditions();\n    });\n    $(\"select\").change(function() {\n        checkSkipConditions();\n    });\n</script>\n</body>\n</html>\n"
          },
