lue=\"84ff308cef1af427e2aba67609794319de7077dc\" />\n\n                    <table class='table table-sm w-100' cellspacing='8'>\n                    <tr>\n                      <td class=\"text-left align-top\">\n                                        </div><div class=\"card\">\n    <div class=\"card-header p-0 bg-secondary\" id=\"header_1\">\n        <h2 class=\"mb-0\">\n            <button class=\"btn btn-link btn-block text-light text-left\" type=\"button\" data-toggle=\"collapse\" data-target=\"#div_1\" aria-expanded=\"true\" aria-controls=\"1\">Who</button>\n        </h2>\n    </div>\n    <div id=\"div_1\" class=\"bg-light collapse show\" aria-labelledby=\"header_1\" >\n        <div class=\"container-xl card-body\"><div class='form-group row'><div class='col-12 col-md-auto col-lg-3 ' id='label_title'>Title:</div><div class='col-12 col-md-auto col-lg-9' id='text_title'><select name=\"form_title\"\nid=\"form_title\"\nclass=\"form-control  form-control-sm mw-100\"\nonchange=\"checkSkipConditions();\"\ntitle=\"Title\"><option value=\"\" selected>Unassigned</option>\n<option value=\"Mr.\" >Mr.</option>\n<option value=\"Mrs.\" >Mrs.</option>\n<option value=\"Ms.\" >Ms.</option>\n<option value=\"Dr.\" >Dr.</option></select></div></div><!-- End BS row -->\n<div class='form-group row'><div class='col-12 col-md-auto col-lg-3 required' id='label_fname'>Name:</div><div class='col-12 col-md-auto col-lg-9' id='text_fname'><input type='text'\n            class='form-control form-control-sm mw-100'\n            name='form_fname'\n            id='form_fname'\n            size='15'\n            maxlength='63'\n             placeholder='First Name' \n            title='First Name'\n            value='' onchange='checkSkipConditions();' /><span class='text-nowrap mr-2'>&nbsp;<input type='text'\n            class='form-control form-control-sm mw-100 mb-1'\n            name='form_mname'\n            id='form_mname'\n            size='5'\n            maxlength='63'\n             placeholder='Middle Name' \n            title='Middle Name'\n            value='' onchange='checkSkipConditions();' /></span> <span class='text-nowrap mr-2'>&nbsp;<input type='text'\n            class='form-control form-control-sm mw-100 mb-1'\n            name='form_lname'\n            id='form_lname'\n            size='20'\n            maxlength='63'\n             placeholder='Last Name' \n            title='Last Name'\n            value='' onchange='checkSkipConditions();' /></span> <span class='text-nowrap mr-2'>&nbsp;<input type='text'\n            class='form-control form-control-sm mw-100 mb-1'\n            name='form_suffix'\n            id='form_suffix'\n            size='5'\n            maxlength='63'\n             placeholder='Name Suffix' \n            title='Name Suffix'\n            value='' onchange='checkSkipConditions();' /></span> </div></div><!-- End BS row -->\n<div class='form-group row'><div class='col-12 col-md-auto col-lg-3 ' id='label_preferred_name'>Preferred Name:</div><div class='col-12 col-md-auto col-lg-9' id='text_preferred_name'><input type='text'\n            class='form-control form-control-sm mw-100'\n            name='form_preferred_name'\n            id='form_preferred_name'\n            size='32'\n            maxlength='64'\n             placeholder='Patient preferred name or name patient is commonly known.' \n            title='Patient preferred name or name patient is commonly known.'\n            value='' onchange='checkSkipConditions();' /></div></div><!-- End BS row -->\n<div class='form-group row'><div class='col-12 col-md-auto col-lg-3 ' id='label_pubpid'>External ID:</div><div class='col-12 col-md-auto col-lg-3' id='text_pubpid'><input type='text'\n            class='form-control form-control-sm mw-100'\n            name='form_pubpid'\n            id='form_pubpid'\n            size='10'\n            maxlength='255'\n            \n            title='External identifier'\n            value='' onchange='checkSkipConditions();' /></div><div class='col-12 col-md-auto col-lg-3 required' id='label_DOB'>DOB:</div><div class='col-12 col-md-auto col-lg-3' id='text_DOB'><input type='text' size='10' class='datepicker form-control form-control-sm mw-100' name='form_DOB' id='form_DOB' value='' title='Date of Birth' autocomplete='off'  onchange='checkSkipConditions();'  /></div></div><!-- End BS row -->\n<div class='form-group row'><div class='col-12 col-md-auto col-lg-3 required' id='label_sex'>Birth Sex:</div><div class='col-12 col-md-auto col-lg-3' id='text_sex'><select name=\"form_sex\"\nid=\"form_sex\"\nclass=\"form-control  form-control-sm mw-100\"\nonchange=\"checkSkipConditions();\"\ntitle=\"Birth Sex\"><option value=\"\" selected>Unassigned</option>\n<option value=\"Female\" >Female</option>\n<option value=\"Male\" >Male</option>\n<option value=\"UNK\" >Unknown</option></select></div><div class='col-12 col-md-auto col-lg-3 ' id='label_ss'>S.S.:</div><div class='col-12 col-md-auto col-lg-3' id='text_ss'><input type='text'\n            class='form-control form-control-sm mw-100'\n            name='form_ss'\n            id='form_ss'\n            size='11'\n            maxlength='11'\n            \n            title='Social Security Number'\n            value='' onchange='checkSkipConditions();' /></div></div><!-- End BS row -->\n<div class='form-group row'><div class='col-12 col-md-auto col-lg-3 ' id='label_drivers_license'>License/ID:</div><div class='col-12 col-md-auto col-lg-3' id='text_drivers_license'><input type='text'\n            class='form-control form-control-sm mw-100'\n            name='form_drivers_license'\n            id='form_drivers_license'\n            size='15'\n            maxlength='63'\n            \n            title='Drivers License or State ID'\n            value='' onchange='checkSkipConditions();' /></div><div class='col-12 col-md-auto col-lg-3 ' id='label_status'>Marital Status:</div><div class='col-12 col-md-auto col-lg-3' id='text_status'><select name=\"form_sta