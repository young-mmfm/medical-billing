        },
        "_priority": "High",
        "_resourceType": "script",
        "cache": {},
        "connection": "443",
        "request": {
          "method": "GET",
          "url": "https://demo.openemr.io/openemr/library/textformat.js?v=82",
          "httpVersion": "http/1.1",
